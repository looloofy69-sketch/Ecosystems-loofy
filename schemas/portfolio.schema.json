{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ecosystems-loofy/portfolio.schema.json",
  "title": "Ecosystem Portfolio Registry",
  "description": "Evidence-backed inventory of first-party repositories and their integration state. The example.invalid identifier is a placeholder until a stable hosted schema URL exists.",
  "type": "object",
  "required": ["schema_version", "registry", "repository", "updated_at", "policy", "components", "connections"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "registry": { "const": "ecosystem/portfolio.json" },
    "repository": { "const": "looloofy69-sketch/Ecosystems-loofy" },
    "updated_at": { "type": "string", "format": "date" },
    "policy": {
      "type": "object",
      "required": ["production_claim_requires", "rule"],
      "properties": {
        "production_claim_requires": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "rule": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "repository_url", "role", "maturity", "integration_state", "production_endpoint", "dependencies", "interfaces", "known_gaps", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "repository_url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
          "role": { "type": "string", "minLength": 1 },
          "maturity": { "enum": ["deployed", "implemented-unverified", "prototype", "specification-only", "governance-only"] },
          "integration_state": { "enum": ["live-core", "adapter-to-core", "local-library", "standalone-mcp", "contract-only", "not-connected"] },
          "production_endpoint": { "type": ["string", "null"], "format": "uri" },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "uniqueItems": true
          },
          "interfaces": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "known_gaps": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "url", "claim"],
              "properties": {
                "kind": { "enum": ["source", "ci", "deployment", "test", "specification"] },
                "url": { "type": "string", "format": "uri", "pattern": "^https://" },
                "claim": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "interface", "state", "required_gates"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "from": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "to": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "interface": { "type": "string", "minLength": 1 },
          "state": { "enum": ["implemented-but-not-end-to-end-verified", "proposed", "blocked", "not-proposed"] },
          "required_gates": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
